{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bili-web",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-10-21",
  "workers_dev": true,
  "assets": { "directory": "./dist", "binding": "ASSETS", "run_worker_first": ["/api/*", "/media"] },
  "observability": { "enabled": false }
}
